{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minutes Archive",
  "identifier": "com.useminutes.archive",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Minutes Archive",
        "width": 1240,
        "height": 820,
        "minWidth": 840,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "icon": [
      "../../tauri/src-tauri/icons/icon.icns",
      "../../tauri/src-tauri/icons/icon.ico",
      "../../tauri/src-tauri/icons/app-icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {}
}
